# Backend
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=achivora

# Admin sign-in for http://localhost:3000/admin
ADMIN_EMAIL=admin@achivora.com
ADMIN_PASSWORD=set-a-strong-password
JWT_SECRET=set-a-long-random-string
JWT_EXPIRY=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# WhatsApp alerts for new form submissions
WHATSAPP_ENABLED=true
WHATSAPP_TO=+918447049584
# callmebot | meta | twilio  (see server/services/whatsapp.js)
WHATSAPP_PROVIDER=callmebot
# Get this once by messaging +34 644 51 95 23 on WhatsApp from +918447049584
# with the text: I allow callmebot to send me messages
WHATSAPP_CALLMEBOT_KEY=
